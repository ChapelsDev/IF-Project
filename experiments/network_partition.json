{
    "version": "1.0.0",
    "title": "Partição de Rede",
    "description": "Isola o nó de um IP específico (Split-Brain).",
    "tags": ["network", "partition", "iptables"],
    "configuration": {
        "target_host": "127.0.0.1",
        "partition_target": "",
        "ssh_user": "root",
        "ssh_password": "",
        "device": "eth0",
        "duration": 30
    },
    "method": [
        {
            "type": "action",
            "name": "inject-network-partition",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "inject_network_partition",
                "arguments": {
                    "target_host": "${target_host}",
                    "ssh_user": "${ssh_user}",
                    "ssh_password": "${ssh_password}",
                    "partition_target": "${partition_target}",
                    "device": "${device}"
                }
            }
        },
        {
            "type": "action",
            "name": "wait-duration",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "wait_seconds",
                "arguments": {
                    "seconds": "${duration}"
                }
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "recover-network-partition",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "recover_network_partition",
                "arguments": {
                    "target_host": "${target_host}",
                    "ssh_user": "${ssh_user}",
                    "ssh_password": "${ssh_password}",
                    "uid": "${partition_target}"
                }
            }
        }
    ]
}