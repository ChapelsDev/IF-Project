{
    "version": "1.0.0",
    "title": "Injeção de Perda de Pacotes",
    "description": "Simula uma rede instável descartando uma porcentagem dos pacotes.",
    "tags": [
        "network",
        "loss",
        "tc"
    ],
    "configuration": {
        "target_host": "127.0.0.1",
        "loss": "20%",
        "ssh_user": "root",
        "ssh_password": "",
        "device": "eth0",
        "duration": 30
    },
    "steady-state-hypothesis": {
        "title": "O serviço deve continuar respondendo apesar da perda de pacotes",
        "probes": [
            {
                "type": "probe",
                "name": "service-is-responding",
                "tolerance": 200,
                "provider": {
                    "type": "http",
                    "url": "http://${target_host}:8500/v1/status/leader",
                    "timeout": 2
                }
            }
        ]
    },
    "method": [
        {
            "type": "action",
            "name": "inject-packet-loss",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "inject_packet_loss",
                "arguments": {
                    "target_host": "${target_host}",
                    "ssh_user": "${ssh_user}",
                    "ssh_password": "${ssh_password}",
                    "loss": "${loss}",
                    "device": "${device}"
                }
            }
        },
        {
            "type": "action",
            "name": "wait-duration",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "wait_seconds",
                "arguments": {
                    "seconds": "${duration}"
                }
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "recover-packet-loss",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "recover_packet_loss",
                "arguments": {
                    "target_host": "${target_host}",
                    "ssh_user": "${ssh_user}",
                    "ssh_password": "${ssh_password}",
                    "uid": "${device}"
                }
            }
        }
    ]
}