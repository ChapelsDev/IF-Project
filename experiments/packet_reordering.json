{
    "version": "1.0.0",
    "title": "Injeção de Reordenação de Pacotes",
    "description": "Simula reordenação de pacotes na rede.",
    "tags": ["network", "reordering", "tc"],
    "configuration": {
        "target_host": "127.0.0.1",
        "reordering": "5%",
        "ssh_user": "root",
        "ssh_password": "",
        "device": "enp7s0",
        "duration": 30
    },
    "method": [
        {
            "type": "action",
            "name": "inject-packet-reordering",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "inject_packet_reordering",
                "arguments": {
                    "target_host": "${target_host}",
                    "ssh_user": "${ssh_user}",
                    "ssh_password": "${ssh_password}",
                    "reordering": "${reordering}",
                    "device": "${device}"
                }
            }
        },
        {
            "type": "action",
            "name": "wait-duration",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "wait_seconds",
                "arguments": {
                    "seconds": "${duration}"
                }
            }
        }
    ],
    "rollbacks": [
        {
            "type": "action",
            "name": "recover-packet-reordering",
            "provider": {
                "type": "python",
                "module": "src.lib.chaos_ssh_driver",
                "func": "recover_packet_reordering",
                "arguments": {
                    "target_host": "${target_host}",
                    "ssh_user": "${ssh_user}",
                    "ssh_password": "${ssh_password}",
                    "uid": "${device}"
                }
            }
        }
    ]
}