# Chat System Client Configuration

# RECOMMENDED: Use load balancer for automatic failover and load distribution
# The load balancer discovers chat nodes via Consul and redirects clients automatically
VITE_CHAT_URL=http://localhost:3000

# Production load balancer
# VITE_CHAT_URL=http://192.168.100.162:3000

# Legacy: Direct connection to chat nodes (client-side failover)
# Comma-separated list - client will randomly select one on startup
# and automatically fail over to another if connection fails

# Local development nodes
# VITE_CHAT_URL=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Single remote node
# VITE_CHAT_URL=http://192.168.100.231:3001

# Multiple remote nodes (manual failover)
# VITE_CHAT_URL=http://192.168.100.231:3001,http://192.168.100.231:3002,http://192.168.100.231:3003

# Mixed local and remote
# VITE_CHAT_URL=http://localhost:3001,http://192.168.100.231:3001,http://192.168.100.162:3001
